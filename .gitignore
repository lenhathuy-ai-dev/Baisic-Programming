# ============================================================
# BASIC PROGRAMMING - SOURCE CODE ONLY
# C#, Java, JavaScript, TypeScript, Kotlin, Swift,
# React, Next.js, React Native, PHP, Python
# Keep source files, project configs, and dependency lockfiles.
# ============================================================

# 1. Editors, IDEs, operating systems
.vscode/
.vs/
.idea/
.fleet/
.history/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
desktop.ini

# 2. Logs, temporary and local cache files
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/
.cache-loader/

# 3. Private config and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pfx
*.p12
*.pem
*.key

# 4. C# / .NET
**/bin/
**/obj/
**/TestResults/
**/packages/
*.nupkg
*.snupkg
*.coverage
*.coveragexml

# 5. Python
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
**/env/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.hypothesis/
**/.ipynb_checkpoints/
*.egg-info/
*.egg
.python-version

# 6. Java / Kotlin / Gradle / Maven
*.class
*.jar
*.war
*.ear
**/.gradle/
**/.kotlin/
**/target/
**/out/
# Gradle wrapper JAR is needed to build from source.
!**/gradle/wrapper/gradle-wrapper.jar

