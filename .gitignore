**/node_modules/
**/.next/
**/.nuxt/
**/.output/
**/.turbo/
**/.parcel-cache/
**/.svelte-kit/
**/.angular/
**/.expo/
**/.expo-shared/
**/.yarn/cache/
**/.yarn/unplugged/
**/.yarn/build-state.yml
**/.pnpm-store/
**/coverage/
**/.nyc_output/
**/dist/
**/build/
**/storybook-static/
*.tsbuildinfo

# 8. React Native / Android / iOS build artifacts
**/android/.cxx/
**/android/.gradle/
**/android/local.properties
**/ios/Pods/
**/ios/DerivedData/
**/ios/build/
**/DerivedData/
*.xcuserstate
**/xcuserdata/

# 9. Swift
**/.build/
**/.swiftpm/
**/.package.resolved.tmp
*.dSYM/
*.dSYM.zip

# 10. PHP / Composer
**/vendor/
.phpunit.cache/
.phpunit.result.cache
.phpunit-watcher.yml
**/bootstrap/cache/*.php
**/storage/framework/cache/data/
**/storage/framework/sessions/
**/storage/framework/views/
**/storage/logs/

# 11. Compiled executables and native build products
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib
*.obj
*.o
*.a
*.so
*.dylib
*.app/
*.ipa
*.apk
*.aab
*.pyc

# 12. Local databases and generated reports
*.sqlite
*.sqlite3
*.db
*.prof
*.profdata

# IMPORTANT: Source and project files remain tracked:
# .cs, .csproj, .sln/.slnx, .java, .kt, .swift, .js, .jsx,
# .ts, .tsx, .php, .py, .ipynb, .json, .xml, .md, etc.
# Also keep package-lock.json, yarn.lock, pnpm-lock.yaml,
# composer.lock, gradle-wrapper.properties and Package.resolved.
